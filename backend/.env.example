# Copy this file to ".env" and put your real keys in it.

# "openai" or "huggingface"
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Only needed if LLM_PROVIDER=huggingface or EMBEDDING_PROVIDER=api
HF_TOKEN=hf_your-token-here
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# "local" runs the embedding model on your machine, "api" uses Hugging Face's servers
EMBEDDING_PROVIDER=local

FRONTEND_ORIGINS=http://localhost:5173
